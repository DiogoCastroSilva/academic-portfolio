{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@katie-portofolio/source"],
    "paths": {
      "@katie-portofolio/content": ["./libs/content/src/index.ts"],
      "@katie-portofolio/projects": ["./libs/projects/src/index.ts"],
      "@katie-portofolio/publications": ["./libs/publications/src/index.ts"],
      "@katie-portofolio/navigation": ["./libs/navigation/src/index.ts"]
    }
  }
}
