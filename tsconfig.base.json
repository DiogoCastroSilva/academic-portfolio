{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@katie-portfolio/source"],
    "paths": {
      "@katie-portfolio/content": ["./libs/content/src/index.ts"],
      "@katie-portfolio/projects": ["./libs/projects/src/index.ts"],
      "@katie-portfolio/publications": ["./libs/publications/src/index.ts"],
      "@katie-portfolio/navigation": ["./libs/navigation/src/index.ts"],
      "@katie-portfolio/utils": ["./libs/utils/src/index.ts"],
      "@katie-portfolio/utils/test-helpers/a11y": [
        "./libs/utils/src/test-helpers/a11y/index.ts"
      ]
    }
  }
}
