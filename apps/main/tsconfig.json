{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "noEmit": true,
    "emitDeclarationOnly": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@academic-portfolio/content": ["../../libs/content/src/index.ts"],
      "@academic-portfolio/projects": ["../../libs/projects/src/index.ts"],
      "@academic-portfolio/projects/*": ["../../libs/projects/src/*"],
      "@academic-portfolio/publications": [
        "../../libs/publications/src/index.ts"
      ],
      "@academic-portfolio/publications/*": ["../../libs/publications/src/*"],
      "@academic-portfolio/blog": ["../../libs/blog/src/index.ts"],
      "@academic-portfolio/blog/*": ["../../libs/blog/src/*"],
      "@academic-portfolio/navigation": ["../../libs/navigation/src/index.ts"],
      "@academic-portfolio/utils": ["../../libs/utils/src/index.ts"],
      "@academic-portfolio/utils/test-helpers/a11y": [
        "../../libs/utils/src/test-helpers/a11y/index.ts"
      ]
    },
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo"
  },
  "include": [
    "../../apps/main/.next/types/**/*.ts",
    "../../dist/apps/main/.next/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "src/**/*.js",
    "src/**/*.jsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "../../public/types/**/*.ts"
  ],
  "exclude": [
    "out-tsc",
    "dist",
    "node_modules",
    ".next",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "__tests__",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ],
  "references": [
    {
      "path": "../../libs/blog"
    },
    {
      "path": "../../libs/utils"
    },
    {
      "path": "../../libs/publications"
    },
    {
      "path": "../../libs/projects"
    },
    {
      "path": "../../libs/navigation"
    },
    {
      "path": "../../libs/content"
    }
  ]
}
