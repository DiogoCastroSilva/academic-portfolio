{
  "name": "@academic-portfolio/main",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "sync-content-assets": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node tools/sync-content-assets.mjs",
          "cwd": "{workspaceRoot}"
        }
      },
      "sync-content-assets-dev": {
        "executor": "nx:run-commands",
        "options": {
          "command": "SKIP_WEBP_CONVERSION=true SKIP_IMAGE_RESIZE=true node tools/sync-content-assets.mjs",
          "cwd": "{workspaceRoot}"
        }
      },
      "generate-og-images": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node tools/generate-og-images.mjs",
          "cwd": "{workspaceRoot}"
        }
      },
      "build": {
        "dependsOn": [
          "sync-content-assets",
          "generate-og-images",
          "^typecheck"
        ],
        "options": {
          "command": "next build --webpack"
        }
      },
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "command": "vitest run --root apps/main",
          "cwd": "{workspaceRoot}"
        },
        "dependsOn": [
          "sync-content-assets"
        ]
      },
      "dev": {
        "dependsOn": [
          "sync-content-assets-dev"
        ],
        "options": {
          "command": "next dev --webpack"
        }
      }
    },
    "tags": [
      "app"
    ]
  },
  "dependencies": {
    "@academic-portfolio/blog": "*",
    "@academic-portfolio/content": "*",
    "@academic-portfolio/navigation": "*",
    "@academic-portfolio/projects": "*",
    "@academic-portfolio/publications": "*",
    "@academic-portfolio/utils": "*",
    "next": "16.4.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  }
}
