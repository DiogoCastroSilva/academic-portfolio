{
  "name": "@katie-portofolio/main",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "sync-content-assets": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node tools/sync-content-assets.mjs",
          "cwd": "{workspaceRoot}"
        }
      },
      "build": {
        "dependsOn": [
          "sync-content-assets"
        ],
        "options": {
          "command": "next build --webpack"
        }
      },
      "dev": {
        "dependsOn": [
          "sync-content-assets"
        ],
        "options": {
          "command": "next dev --webpack"
        }
      }
    }
  },
  "dependencies": {
    "@katie-portofolio/content": "*",
    "@katie-portofolio/navigation": "*",
    "@katie-portofolio/projects": "*",
    "@katie-portofolio/publications": "*",
    "@katie-portofolio/utils": "*",
    "next": "16.4.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  }
}
