{
  "name": "@katie-portfolio/main",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "sync-content-assets": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node tools/sync-content-assets.mjs",
          "cwd": "{workspaceRoot}"
        }
      },
      "sync-content-assets-dev": {
        "executor": "nx:run-commands",
        "options": {
          "command": "SKIP_WEBP_CONVERSION=true node tools/sync-content-assets.mjs",
          "cwd": "{workspaceRoot}"
        }
      },
      "build": {
        "dependsOn": [
          "sync-content-assets",
          "^typecheck"
        ],
        "options": {
          "command": "next build --webpack"
        }
      },
      "generate-sitemap": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node tools/generate-sitemap.mjs",
          "cwd": "{workspaceRoot}"
        }
      },
      "dev": {
        "dependsOn": [
          "sync-content-assets-dev"
        ],
        "options": {
          "command": "next dev --webpack"
        }
      }
    }
  },
  "dependencies": {
    "@katie-portfolio/content": "*",
    "@katie-portfolio/navigation": "*",
    "@katie-portfolio/projects": "*",
    "@katie-portfolio/publications": "*",
    "@katie-portfolio/utils": "*",
    "next": "16.4.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  }
}
